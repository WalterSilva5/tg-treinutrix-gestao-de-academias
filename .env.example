# Copie para .env (ou defina no serviço/Agendador) e ajuste.
# A API não carrega .env sozinha: use as variáveis do ambiente ou um wrapper.

# --- API ---
API_PORT=3001
# Fixe em produção: tokens invalidam quando o segredo é aleatório.
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=troque-esta-senha
# Produção sem alunos de demonstração:
SEED_DEMO=0

# Persistência (disco externo/rede recomendado em produção)
DATA_DIR=./data
# DATA_FILE=./data/state.json
# EVENTS_FILE=./data/events.jsonl
PERSIST_INTERVAL_MS=3000
EVENT_MAX=50000

# Backup e fotos
BACKUP_DIR=./backups
BACKUP_KEEP=7
PHOTO_DIR=./data/photos
PHOTO_MAX_BYTES=409600

# Segurança/limites
MIN_SCORE=0.7
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=300000
MAX_BODY_BYTES=2097152
# Só preencha se o PWA for servido de outra origem:
# CORS_ORIGIN=http://192.168.0.10:3001

# --- Edge ---
EDGE_PORT=3002
API_URL=http://localhost:3001
EDGE_URL=http://localhost:3002
DEVICE_ID=dev_fit4_01
EDGE_LOGIN=admin
EDGE_PASSWORD=troque-esta-senha
SYNC_INTERVAL_MS=30000
# USE_REAL_HARDWARE=1
# EDGE_TOKEN=troque-por-um-token-do-edge
