# Copie para .env (ou defina no serviço/Agendador) e ajuste.
# A API não carrega .env sozinha: use as variáveis do ambiente ou um wrapper.

# --- API ---
API_PORT=3001
# Fixe em produção. Sem AUTH_SECRET a API cria data/auth.secret (tokens persistem).
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=troque-esta-senha
# Produção sem alunos de demonstração:
SEED_DEMO=0

# Persistência SQLite (Node 22+; sem Docker). O JSON antigo é migrado no 1º boot.
DATA_DIR=./data
DB_FILE=./data/painel.db
# DATA_FILE/EVENTS_FILE só para migração do formato antigo:
# DATA_FILE=./data/state.json
# EVENTS_FILE=./data/events.jsonl
PERSIST_INTERVAL_MS=3000
EVENT_MAX=50000

# Backup e fotos
BACKUP_DIR=./backups
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=24
PHOTO_DIR=./data/photos
PHOTO_MAX_BYTES=409600

# Segurança/limites
MIN_SCORE=0.7
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=300000
MAX_BODY_BYTES=2097152
# Sorteios programados: intervalo do scheduler (0 desliga)
RAFFLE_INTERVAL_MS=60000
# Só preencha se o PWA for servido de outra origem:
# CORS_ORIGIN=http://192.168.0.10:3001

# --- Edge ---
EDGE_PORT=3002
API_URL=http://localhost:3001
EDGE_URL=http://localhost:3002
DEVICE_ID=dev_fit4_01
EDGE_LOGIN=admin
EDGE_PASSWORD=troque-esta-senha
SYNC_INTERVAL_MS=30000
# USE_REAL_HARDWARE=1
# EDGE_TOKEN=troque-por-um-token-do-edge
# simulator | easyinner | generic_http | topdata_facial_ws
# DEVICE_DRIVER=simulator
# EASYINNER_AUTOSTART=0        # 1 = sobe o bridge C# sozinho no Windows
# EASYINNER_PORT=5011          # porta local da ponte
# EASYINNER_INNER_PORT=3000    # porta TCP da catraca (se não vier do cadastro)
# DEVICE_ENDPOINT=http://192.168.0.100:80/open   # driver generic_http
# FACIAL_WS_PORT=3003
# DISCOVER_MIN_MS=5000
