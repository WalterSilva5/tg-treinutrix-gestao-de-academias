// Modelo de referência. Fundir no back/prisma/schema.prisma do treina.ai-api.
// Convenção: tabelas de acesso prefixadas com Access*.

model AccessPerson {
  id         String    @id @default(cuid())
  nome       String
  matricula  String    @unique
  tipo       String    @default("ALUNO") // ALUNO | PERSONAL | VISITANTE
  treinutrix String?   // link ou @usuário do perfil na Treinutrix
  cpf        String?
  ativo      Boolean   @default(true)
  fotoUrl    String?
  validadeIni DateTime?
  validadeFim DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  rules      AccessRule[]
  events     AccessEvent[]
  syncQueue  AccessSyncQueue[]
}

model AccessDevice {
  id        String    @id @default(cuid())
  nome      String
  ip        String
  porta     Int       @default(3570)
  tipo      String    @default("FIT4")
  online    Boolean   @default(false)
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rules     AccessRule[]
  events    AccessEvent[]
  syncQueue AccessSyncQueue[]
}

model AccessRule {
  id         String       @id @default(cuid())
  personId   String
  deviceId   String
  diasSemana Int          // bitmask dom=1 seg=2 ter=4 qua=8 qui=16 sex=32 sab=64
  horaIni    String       // "HH:MM"
  horaFim    String       // "HH:MM"
  person     AccessPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  device     AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([personId, deviceId])
}

model AccessSyncQueue {
  id        String       @id @default(cuid())
  personId  String
  deviceId  String
  operacao  String       // UPSERT | DELETE
  status    String       @default("PENDING") // PENDING | SENT | ERROR
  tentativas Int         @default(0)
  payload   String?      // JSON
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  person    AccessPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  device    AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model AccessEvent {
  id         String        @id @default(cuid())
  deviceId   String
  personId   String?
  timestamp  DateTime      @default(now())
  direcao    String        // IN | OUT
  metodo     String        // FACIAL | MANUAL | QR
  score      Float?
  decisao    String        // ALLOW | DENY
  motivo     String?
  createdAt  DateTime      @default(now())
  device     AccessDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  person     AccessPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
}
